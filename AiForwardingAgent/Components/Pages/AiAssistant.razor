@page "/aiassistant"
@implements IDisposable
@rendermode InteractiveServer

@inject AiForwardingAgent.Services.AiAssistantSession AssistantSession

<PageTitle>AI Assistant</PageTitle>

<h1>AI Assistant</h1>

<div class="mb-3 d-flex gap-2">
    <button class="btn btn-primary" @onclick="StartAsync" disabled="@AssistantSession.IsRunning">
        Start
    </button>

    <button class="btn btn-warning" @onclick="StopAsync" disabled="@(!AssistantSession.IsRunning)">
        Stop
    </button>

    <button class="btn btn-outline-secondary" @onclick="ClearMessages">
        Leeren
    </button>
</div>

<div class="mb-3">
    <strong>Status:</strong> @(AssistantSession.IsRunning ? "Läuft" : "Gestoppt")
</div>

@if (AssistantSession.PendingReview is { } review)
{
    <div class="alert alert-warning">
        <h5>Manuelle Prüfung für Anfrage @review.FreightRequest.FreightRequestId</h5>
        <pre style="white-space: pre-wrap">@review.Reason</pre>
        <input class="form-control mb-2" placeholder="Kommentar (optional)" @bind="_reviewComment" />
        <div class="d-flex gap-2">
            <button class="btn btn-success" @onclick="() => CompleteReview(true)">Freigeben</button>
            <button class="btn btn-danger" @onclick="() => CompleteReview(false)">Ablehnen</button>
        </div>
    </div>
}

<select class="form-select" size="15" style="min-height: 350px;" multiple>
    @foreach (var message in _messages)
    {
        <option>@message</option>
    }
</select>

@code {
    private List<string> _messages = [];
    private string? _reviewComment;

    private void CompleteReview(bool approved)
    {
        AssistantSession.CompleteReview(approved, _reviewComment);
        _reviewComment = null;
    }

    private void OnReviewChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnInitialized()
    {
        RefreshMessages();
        AssistantSession.MessagesChanged += OnMessagesChanged;
        AssistantSession.ReviewChanged += OnReviewChanged;
    }

    private async Task StartAsync()
    {
        await AssistantSession.StartAsync();
        RefreshMessages();
    }

    private async Task StopAsync()
    {
        await AssistantSession.StopAsync();
        RefreshMessages();
    }

    private void ClearMessages()
    {
        AssistantSession.ClearMessages();
        RefreshMessages();
    }

    private void OnMessagesChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshMessages();
            StateHasChanged();
        });
    }

    private void RefreshMessages()
    {
        _messages = AssistantSession
            .GetMessages()
            .Reverse()
            .ToList();
    }

    public void Dispose()
    {
        AssistantSession.MessagesChanged -= OnMessagesChanged;
        AssistantSession.ReviewChanged -= OnReviewChanged;
    }
}